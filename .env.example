# ─────────────────────────────────────────────────────────────
# LYCEE.SIN — environment variables
# Copy to `.env` (Docker Compose reads it automatically) and edit.
# ─────────────────────────────────────────────────────────────

# --- Database (required) ---------------------------------------------------
# The app, the migrate script and the seed all read DATABASE_URL.
#
# Local development (CONTRIBUTING.md §4, chemin B): leave the line below as it
# is. It points at the Postgres container started by `docker compose up -d db`,
# and `pnpm db:setup` / `pnpm dev` read it from this file automatically — you
# never have to type an `export` or a `$env:` line.
DATABASE_URL=postgres://lycee:lycee@localhost:5432/lycee_sin
#
# `docker compose up` (chemin A) ignores the line above: every service is given
# its own DATABASE_URL pointing at the `db` container. Set it by hand only to
# point at an external Postgres, e.g. postgres://user:password@host:5432/dbname

# Credentials for the bundled Postgres container. They must match DATABASE_URL
# above. ⚠️ If you host this site for real, change POSTGRES_PASSWORD here and
# in DATABASE_URL — see SELF_HOSTING.md.
POSTGRES_USER=lycee
POSTGRES_PASSWORD=lycee
POSTGRES_DB=lycee_sin

# Host port for the database, loopback only. Change it if something else on
# your machine already uses 5432 (and change it in DATABASE_URL too).
POSTGRES_PORT=5432

# --- Admin bootstrap -------------------------------------------------------
# The seed ensures one admin account exists.
#   SEED_ADMIN_PSEUDO       login pseudo for the teacher account (default "prof")
#   SEED_ADMIN_PASSPHRASE   if left empty, a random passphrase is generated and
#                           PRINTED ONCE in the `init` container logs — copy it.
SEED_ADMIN_PSEUDO=prof
SEED_ADMIN_PASSPHRASE=

# --- App -------------------------------------------------------------------
# Host port to expose the app on (container always listens on 3000).
APP_PORT=3000

# --- Avatars (optional) -----------------------------------------------------
# Where uploaded profile pictures are written. Defaults to <cwd>/data/avatars
# for local dev and to /app/data/avatars in the Docker image (a bind mount —
# see brutalist-lycee.yml in the homelab repo). Only set this to point the
# app at a different directory, e.g. in tests.
# AVATAR_DIR=/app/data/avatars
