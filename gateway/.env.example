# Terminal gateway configuration (reference service — run separately)

# Port the gateway listens on.
PORT=8080

# Container image used for each student session (must contain /bin/sh).
CONTAINER_IMAGE=alpine:3.20

# REQUIRED. This gateway talks to Docker only through a dedicated socket
# proxy — never a mounted /var/run/docker.sock. Point this at
# socket-proxy-lycee, e.g. tcp://10.0.0.2:2375 (or the service name on
# the shared compose network, e.g. tcp://socket-proxy-lycee:2375).
# The gateway refuses to start if this is unset or not of the form
# tcp://host:port.
DOCKER_HOST=tcp://10.0.0.2:2375

# REQUIRED. Students must present a valid JWT (?token=... or Authorization
# header) signed with this secret. There is no unauthenticated mode — the
# gateway refuses to start if this is empty. Use the same value the main app
# signs tokens with (see app/actions/terminal.ts / TERMINAL_JWT_SECRET).
#
# SECURITY NOTE: socket-proxy-lycee narrows the Docker API surface (it blocks
# /build, /images, /volumes, /networks, /exec, /system, ...) but it CANNOT
# prevent container-create escalation: POST=1 + CONTAINERS=1 admits every
# write verb under /containers, including a create with
# HostConfig.Binds: ["/:/host"] — root on the host. The proxy is defence in
# depth. This JWT gate is the load-bearing control.
JWT_SECRET=

# Session limits.
IDLE_TIMEOUT_MS=120000
MAX_SESSION_MS=600000
# Sized for one classroom, not an arbitrary cap: at 256MB per session, 15
# concurrent sessions is ~3.84GB of worst-case RAM.
MAX_CONCURRENT=15

# --- Frontend side (set in the Next.js app's environment) ---
# Point the browser terminal at this gateway to leave the local sandbox:
# NEXT_PUBLIC_TERMINAL_WS_URL=ws://localhost:8080/terminal
