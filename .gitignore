# v0 runtime files (should only exist in preview, not in git)
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts

# Common ignores
node_modules/
.next/

# Every local env file. `.env` is the one CONTRIBUTING.md tells you to create,
# and `git add -A` would otherwise commit your database password to a public
# repo (GitHub push protection does not flag a plain Postgres password).
# `.env.example` is the tracked template and is deliberately not matched here.
.env
.env.*
!.env.example
.DS_Store
.vercel

# Local-dev avatar uploads (default AVATAR_DIR target; production uses a
# bind mount outside the repo — see lib/avatar-storage.ts)
/data/avatars/

# Secrets de la chasse — la liste privée ne remonte JAMAIS dans le dépôt.
# Le dépôt est public : `db/seeds/secrets.ts` a déjà publié les 153 premiers
# codes avec le jeu, et on ne dépublie pas. Les suivants vivent ici, et
# `db/secrets.example.yml` (versionné, sans rien de neuf) suffit à documenter
# le format.
db/secrets.yml
db/secrets.*.yml
!db/secrets.example.yml

# sdd scratch
.superpowers/

# generated by next build; references the gitignored .next/ types
next-env.d.ts

# tsc incremental cache
*.tsbuildinfo
